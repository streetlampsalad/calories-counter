# Copy to .env.local. For local development, take both values from `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Reminders (spec 016, ADR 0005). Server-only, except the VAPID public key. `pnpm env:local` fills
# these in for local development; production values are set by the setup wizard in spec 016 slice 3.
SUPABASE_SECRET_KEY=sb_secret_replace_me
REMINDER_SECRET=replace_with_a_long_random_string
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Feature Requests (specs/124-feature-requests/). Server only. A fine-grained token limited to this
# repo with Issues: read and write; ./scripts/setup-feature-requests.sh sets it in Vercel. Locally
# and in CI, FEATURE_ISSUES=fake creates no real Issues.
GITHUB_FEATURE_REQUESTS_TOKEN=
FEATURE_ISSUES=fake
# The board workflow sends Feature Request stages with this; set the same value in Vercel and as
# the GitHub Actions secret of the same name (./scripts/setup-feature-requests.sh does both).
FEATURE_REQUESTS_SYNC_SECRET=replace_with_a_long_random_string
