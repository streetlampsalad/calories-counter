# Copy to .env.local. For local development, take both values from `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Reminders (spec 016, ADR 0005). Server-only, except the VAPID public key. `pnpm env:local` fills
# these in for local development; production values are set by the setup wizard in spec 016 slice 3.
SUPABASE_SECRET_KEY=sb_secret_replace_me
REMINDER_SECRET=replace_with_a_long_random_string
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
