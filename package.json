{
  "name": "calories-counter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:journeys && pnpm test:e2e:performance",
    "test:e2e:journeys": "playwright test --project=android",
    "test:e2e:performance": "playwright test --project=performance",
    "env:local": "node scripts/local-env.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level error",
    "db:types": "node scripts/db-types.mjs --write",
    "db:types:check": "node scripts/db-types.mjs --check",
    "validate": "node scripts/validate.mjs",
    "validate:fast": "node scripts/validate.mjs --fast"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.32.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@tanstack/react-query-devtools": "^5.105.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "read-excel-file": "^9.3.14",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  }
}
